diff --git a/iso15118/shared/defense.py b/iso15118/shared/defense.py
new file mode 100644
index 0000000..396c119
--- /dev/null
+++ b/iso15118/shared/defense.py
@@ -0,0 +1,106 @@
+"""
+Defense prototype helpers for the Plug & Charge relay-attack testbed.
+
+Implements the countermeasures described in the testbed's
+defense/README.md against the relay attack (arXiv:2512.15966) and the
+station-certificate reuse weakness (arXiv:2404.06635, section 5.3):
+
+1. Station binding (blocks the relay attack): the EVCC adds one extra
+   Reference to the XML-DSig SignedInfo of its AuthorizationReq whose
+   digest covers
+
+       EVSE-ID || SHA-256(SECC TLS leaf certificate, DER)
+
+   The SECC recomputes the same value with its OWN EVSE-ID and its OWN
+   leaf certificate. A signature relayed from a session with a fake
+   station binds the fake station's identity and fails verification at
+   the honest station. The binding value is not a message element; only
+   its digest enters SignedInfo, so no ISO 15118-2 schema change is
+   needed and a baseline peer ignores the extra Reference.
+
+2. Station pinning (blocks wrong-station certificates): when the
+   EXPECTED_SECC_ID environment variable is set, the EVCC aborts the
+   session before signing anything if neither the presented station
+   certificate's CN nor the session EVSE-ID matches it.
+
+3. Freshness (defense in depth): the SECC timestamps the GenChallenge
+   it sends in PaymentDetailsRes and rejects the first AuthorizationReq
+   that arrives later than FRESHNESS_BOUND_S seconds (default 2.0,
+   inside ISO 15118-2's own 2 s response timeout for this message).
+
+All behavior is off unless the DEFENDED environment variable is set, so
+one patched tree serves baseline and defended runs: scripts/80 flips the
+env var, no code changes between modes.
+"""
+import hashlib
+import logging
+import os
+from typing import Optional
+
+from cryptography.x509 import load_der_x509_certificate
+from cryptography.x509.oid import NameOID
+
+logger = logging.getLogger(__name__)
+
+# XML-DSig Reference id for the synthetic station-binding element. It is
+# not part of the V2G message body; only its digest enters SignedInfo.
+STATION_BINDING_ID = "stationBinding"
+
+_DEFAULT_FRESHNESS_BOUND_S = 2.0
+
+
+def defense_enabled() -> bool:
+    """True when the DEFENDED environment variable requests defended
+    behavior (any value other than empty/0/false/no/off)."""
+    return os.getenv("DEFENDED", "").strip().lower() not in (
+        "",
+        "0",
+        "false",
+        "no",
+        "off",
+    )
+
+
+def expected_secc_id() -> Optional[str]:
+    """The operator-announced expected station identity, or None."""
+    value = os.getenv("EXPECTED_SECC_ID", "").strip()
+    return value or None
+
+
+def freshness_bound_s() -> float:
+    """Maximum allowed PaymentDetailsRes -> AuthorizationReq round trip."""
+    try:
+        return float(os.getenv("FRESHNESS_BOUND_S", _DEFAULT_FRESHNESS_BOUND_S))
+    except ValueError:
+        return _DEFAULT_FRESHNESS_BOUND_S
+
+
+def peer_cert_der(writer) -> Optional[bytes]:
+    """DER encoding of the TLS peer's leaf certificate, or None when the
+    connection is not TLS or no certificate was presented."""
+    ssl_object = writer.get_extra_info("ssl_object")
+    if ssl_object is None:
+        return None
+    try:
+        return ssl_object.getpeercert(binary_form=True)
+    except (AttributeError, ValueError):
+        return None
+
+
+def cert_cn_der(cert_der: Optional[bytes]) -> Optional[str]:
+    """Common Name of a DER-encoded certificate, or None."""
+    if not cert_der:
+        return None
+    try:
+        cert = load_der_x509_certificate(cert_der)
+    except ValueError:
+        return None
+    attrs = cert.subject.get_attributes_for_oid(NameOID.COMMON_NAME)
+    return attrs[0].value if attrs else None
+
+
+def station_binding_bytes(evse_id: Optional[str], secc_cert_der: bytes) -> bytes:
+    """The value both sides of a defended session digest into the
+    AuthorizationReq signature: the identity of the station the signer is
+    talking to. Both sides must construct it identically."""
+    return (evse_id or "").encode("utf-8") + hashlib.sha256(secc_cert_der).digest()
